[Unit]
Description=Bajahoe P2 API server
After=network-online.target bajahoe-llm.service bajahoe-voice.service
Wants=network-online.target

[Service]
Type=simple
User=bajahoe
WorkingDirectory=/opt/bajahoe/mobilesystem/p2_board_api
EnvironmentFile=/etc/bajahoe.env
ExecStart=/opt/bajahoe/mobilesystem/p2_board_api/.venv/bin/python -m service.api_server.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
